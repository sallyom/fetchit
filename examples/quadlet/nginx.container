# Nginx Web Server Quadlet Container File
# This file demonstrates a simple web server deployment using Quadlet

[Unit]
Description=Nginx Web Server
After=network-online.target
Wants=network-online.target

[Container]
# Container image to use
Image=docker.io/nginx:latest

# Port mappings: host_port:container_port
PublishPort=8080:80

# Volume mounts
Volume=webapp-data.volume:/usr/share/nginx/html:Z

# Network configuration
Network=webapp.network

# Environment variables
Environment=NGINX_PORT=80
Environment=NGINX_HOST=localhost

# Run container as specific user (optional)
# User=1000
# Group=1000

# Additional Podman arguments (optional)
# PodmanArgs=--health-cmd="curl -f http://localhost/ || exit 1"

[Service]
# Restart policy
Restart=always
TimeoutStartSec=300

# Pre-start commands (optional)
# ExecStartPre=/usr/bin/echo "Starting Nginx"

# Post-start commands (optional)
# ExecStartPost=/usr/bin/echo "Nginx started"

[Install]
# Start on boot
WantedBy=multi-user.target default.target
